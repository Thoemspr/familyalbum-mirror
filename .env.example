# --- FamilyAlbum mirror settings ---------------------------------------------
# Copy to .env and adjust. Albums and their share links go into config.json.

# Owner of the files in ./album on the host (`id -u` / `id -g`).
PUID=1000
PGID=1000

# Where the mirror is stored on the host: originals, thumbnails, index, gallery.
FA_DATA_DIR=./album

# Time zone for photo dates and the schedule.
TZ=Europe/Zurich

# --- Crawler -----------------------------------------------------------------
# When to sync (cron syntax: minute hour day month weekday). Default: 03:30 daily.
SYNC_SCHEDULE="30 3 * * *"
# Also run once whenever the container starts (handy for the very first run).
RUN_ON_START=true
# Thumbnail size in pixels (longest side).
FA_THUMB_SIZE=640

# --- Notifications (optional) ------------------------------------------------
# errors = only when something fails · all = also new photos/comments · off
FA_NOTIFY=errors
# Telegram: create a bot with @BotFather, send it a message, then get the chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates . Leave empty for none.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Offsite copy with rclone (optional) -------------------------------------
# Remote and folder for the originals, e.g. onedrive:Pictures/FamilyAlbum
# Each album lands in its own subfolder. Empty = no upload.
# One-off setup: docker compose run --rm sync rclone config
RCLONE_REMOTE=
RCLONE_BWLIMIT=10M
RCLONE_TRANSFERS=4

# --- Web gallery -------------------------------------------------------------
# ":80" when a reverse proxy (Nginx Proxy Manager, Traefik, Caddy, ...) handles
# HTTPS. Or your domain, e.g. photos.example.com, for automatic HTTPS — then set
# FA_HTTP_PORT=80 and FA_HTTPS_PORT=443 and forward both ports to this host.
FA_SITE_ADDRESS=:80
FA_HTTP_PORT=8080
FA_HTTPS_PORT=8443

# Login for the gallery. Create the hash with
#   docker compose run --rm sync caddy hash-password --plaintext 'your-password'
# and keep the single quotes: the hash contains $ signs.
FA_AUTH_USER=family
FA_AUTH_HASH=''

# Use a specific image version instead of latest, e.g. ...:v1.0.0
#FA_IMAGE=ghcr.io/thoemspr/familyalbum-mirror:latest
